<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Propose Workforce button only exists when Workforce is installed. -->
    <record id="view_htplus_schedule_run_form_workforce" model="ir.ui.view">
        <field name="name">htplus.schedule.run.form.workforce</field>
        <field name="model">htplus.schedule.run</field>
        <field name="inherit_id" ref="htplus_aps_core.view_htplus_schedule_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                    <button name="action_propose_workforce" string="Propose Workforce"
                        type="object"
                        invisible="state not in ['draft', 'calculated', 'confirmed']"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_open_assignments" string="Open Assignments"
                        type="object"
                        invisible="not workorder_ids"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                        <button name="action_open_assignments" type="object"
                            class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Assignments</span>
                            </div>
                        </button>
            </xpath>
        </field>
    </record>
</odoo>
