<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_shift_dashboard_open" model="ir.actions.server">
        <field name="name">Shift Management Dashboard</field>
        <field name="model_id" ref="htplus_aps_core.model_htplus_dashboard_kpi"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_shift_dashboard()</field>
    </record>

    <delete model="ir.actions.act_window"
        search="[('name', '=', 'Shift Management Dashboard'), ('res_model', '=', 'htplus.dashboard.kpi')]"/>

    <record id="view_htplus_shift_dashboard_kpi_form" model="ir.ui.view">
        <field name="name">htplus.shift.dashboard.kpi.form</field>
        <field name="model">htplus.dashboard.kpi</field>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <form string="Shift Management Dashboard">
                <header>
                    <button name="action_refresh" string="Refresh" type="object"
                        class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <div class="row">
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="total_shifts"/></h3><div class="text-muted small">Total Shifts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">
                                        <field name="assignment_rate" widget="percentpie"/>
                                    </h3><div class="text-muted small">Assignment Rate</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-success">
                                        <field name="completion_rate" widget="percentpie"/>
                                    </h3><div class="text-muted small">Completion Rate</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-warning"><field name="confirmed_shifts"/></h3><div class="text-muted small">Confirmed Shifts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-success"><field name="completed_shifts"/></h3><div class="text-muted small">Completed Shifts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="shortage_shifts == 0"><field name="shortage_shifts"/></h3><h3 class="text-muted" invisible="shortage_shifts != 0"><field name="shortage_shifts"/></h3><div class="text-muted small">Shifts Short Manpower</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="total_ot_minutes"/></h3><div class="text-muted small">Total Overtime (min)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group>
                        <button name="action_open_shifts" string="Open Shifts" type="object"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_shift_dashboard"
        parent="htplus_workforce.menu_htplus_shift_mgmt"
        action="action_htplus_shift_dashboard_open"
        sequence="50"/>
</odoo>
