<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manning KPIs only exist when Workforce is installed. -->
    <record id="view_htplus_dashboard_kpi_form_workforce" model="ir.ui.view">
        <field name="name">htplus.dashboard.kpi.form.workforce</field>
        <field name="model">htplus.dashboard.kpi</field>
        <field name="inherit_id" ref="htplus_aps_core.view_htplus_dashboard_kpi_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='kpi_tiles']" position="inside">
                <div class="col-6 col-md-4 col-xl-2 mb-2">
                    <div class="card">
                        <div class="card-body text-center">
                            <h3 class="text-danger" invisible="assignment_conflict_count == 0"><field name="assignment_conflict_count"/></h3><h3 class="text-muted" invisible="assignment_conflict_count != 0"><field name="assignment_conflict_count"/></h3><div class="text-muted small">Assignment Conflicts</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2 mb-2">
                    <div class="card">
                        <div class="card-body text-center">
                            <h3 class="text-danger" invisible="shortage_shifts == 0"><field name="shortage_shifts"/></h3><h3 class="text-muted" invisible="shortage_shifts != 0"><field name="shortage_shifts"/></h3><div class="text-muted small">Shifts Short Manpower</div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//button[@name='action_open_workorders']" position="after">
                <button name="action_open_shifts" string="Open Shifts" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>
