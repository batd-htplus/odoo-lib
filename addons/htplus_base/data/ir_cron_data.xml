<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Pulls due htplus.job rows. Fields dropped in Odoo 17 (numbercall, doall)
        are deliberately absent: including them makes the module fail to install.
    -->
    <record id="ir_cron_htplus_job" model="ir.cron">
        <field name="name">HTPlus: Run background jobs</field>
        <field name="model_id" ref="model_htplus_job"/>
        <field name="state">code</field>
        <field name="code">model._claim_and_run_next()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
