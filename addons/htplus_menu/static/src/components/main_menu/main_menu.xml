<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="htplus_menu.MainMenu">
        <div class="o_htplus_main_menu">
            <div class="o_htplus_main_menu_background"
                 t-att-style="'background: conic-gradient(from ' + deg + ', #71639e, #8274AF)'"/>
            <div class="o_htplus_main_menu_panel">
                <div class="o_htplus_apps_container">
                    <t t-foreach="apps" t-as="app" t-key="app.id">
                        <a href="#" role="button"
                           t-att-aria-label="app.name"
                           t-on-click.prevent="() => this.onClickModule(app)">
                            <img class="o_htplus_module_icon"
                                 t-att-src="app.webIconData || '/htplus_menu/static/src/img/default_icon.png'"
                                 t-att-alt="app.name"/>
                            <p t-esc="app.name" class="text-white fs-5 text-truncate"/>
                        </a>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
