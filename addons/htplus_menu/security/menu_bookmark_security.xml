<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Without this rule the ACL in ir.model.access.csv grants every
            internal user read/write/unlink on EVERY bookmark row. The
            `[('user_id','=',uid)]` domain on the action only filters the UI -
            a direct call_kw with an empty domain would return, and could
            modify, other users' bookmarks.
        -->
        <record id="menu_bookmark_rule_own" model="ir.rule">
            <field name="name">Bookmark: own records only</field>
            <field name="model_id" ref="model_menu_bookmark"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Administrators need to see every bookmark to clean up after a
            departed user. Global rules are ANDed with group rules, so this is
            a separate group-scoped rule that ORs with the one above.
        -->
        <record id="menu_bookmark_rule_admin" model="ir.rule">
            <field name="name">Bookmark: administrators see all</field>
            <field name="model_id" ref="model_menu_bookmark"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
