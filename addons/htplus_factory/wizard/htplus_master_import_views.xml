<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_htplus_master_import_form" model="ir.ui.view">
        <field name="name">htplus.master.import.wizard.form</field>
        <field name="model">htplus.master.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Factory Master Data">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="dry_run"/>
                </group>
                <div class="text-muted">
                    One row per path down the hierarchy. Recognised columns:
                    <code>factory_code, factory_name, plant_code, plant_name,
                    line_code, line_name, workcenter_code, workcenter_name,
                    machine_code, machine_name</code>.
                    Records are matched by code, so a corrected sheet can be
                    re-imported without creating duplicates.
                </div>
                <field name="result" readonly="1" invisible="not result"/>
                <footer>
                    <button name="action_import" string="Run" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_htplus_master_import" model="ir.actions.act_window">
        <field name="name">Import Master Data</field>
        <field name="res_model">htplus.master.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_htplus_master_import"
        parent="htplus_aps_menu_master_data"
        action="action_htplus_master_import"
        sequence="200"
        groups="htplus_factory.group_aps_manager"/>
</odoo>
