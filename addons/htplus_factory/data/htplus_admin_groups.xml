<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Give the administrator the HTPlus roles on install. Lives here because
        this module declares the groups; referencing them from anywhere else
        would create a second, empty group under a different XML id.

        Note this grants roles only. Factory scope is deliberately NOT granted:
        see group_htplus_all_factories.
    -->
    <record id="group_aps_manager" model="res.groups">
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_mes_operator" model="res.groups">
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_htplus_all_factories" model="res.groups">
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
