        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_plant_all_factories" model="ir.rule">
        <field name="name">htplus.plant: all factories</field>
        <field name="model_id" ref="model_htplus_plant"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_htplus_line_factory" model="ir.rule">
        <field name="name">htplus.line: own factories only</field>
        <field name="model_id" ref="model_htplus_line"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_line_all_factories" model="ir.rule">
        <field name="name">htplus.line: all factories</field>
        <field name="model_id" ref="model_htplus_line"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_mrp_workcenter_factory" model="ir.rule">
        <field name="name">mrp.workcenter: own factories only</field>
        <field name="model_id" ref="mrp.model_mrp_workcenter"/>
