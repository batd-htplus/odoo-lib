        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_mrp_workcenter_all_factories" model="ir.rule">
        <field name="name">mrp.workcenter: all factories</field>
        <field name="model_id" ref="mrp.model_mrp_workcenter"/>
