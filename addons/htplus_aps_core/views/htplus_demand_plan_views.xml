<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_demand_plan" model="ir.actions.act_window">
        <field name="name">Demand Plans</field>
        <field name="res_model">htplus.demand.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_demand_plan_tree" model="ir.ui.view">
        <field name="name">htplus.demand.plan.tree</field>
        <field name="model">htplus.demand.plan</field>
        <field name="arch" type="xml">
            <list string="Demand Plans">
                <field name="name"/>
                <field name="factory_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="source"/>
                <field name="state"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_demand_plan_form" model="ir.ui.view">
        <field name="name">htplus.demand.plan.form</field>
        <field name="model">htplus.demand.plan</field>
        <field name="arch" type="xml">
            <form string="Demand Plan">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="',confirm,' not in htplus_allowed_transitions" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_approve" string="Approve" type="object"
                        invisible="',approve,' not in htplus_allowed_transitions"
                        groups="htplus_factory.group_aps_manager"/>
                    <button name="action_generate_plan" string="Generate Production Plan"
                        type="object" invisible="',plan,' not in htplus_allowed_transitions" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="',cancel,' not in htplus_allowed_transitions"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_export_excel" string="Export Excel" type="object"
                        class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                    <field name="htplus_allowed_transitions" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_production_plans" type="object"
                            class="oe_stat_button" icon="fa-industry"
                            invisible="production_plan_count == 0">
                            <field name="production_plan_count" widget="statinfo"
                                string="Production Plans"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list string="Demand Lines" editable="bottom">
                                    <field name="sequence"/>
                                    <field name="product_id"/>
                                    <field name="date"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="forecast_confidence"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_htplus_demand_plan_search" model="ir.ui.view">
        <field name="name">htplus.demand.plan.search</field>
        <field name="model">htplus.demand.plan</field>
        <field name="arch" type="xml">
            <search string="Demand Plans">
                <field name="name"/>
                <field name="user_id"/>
                <field name="source"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="planned" string="Planned" domain="[('state','=','planned')]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_source" string="Source" context="{'group_by':'source'}"/>
                    <filter name="group_user" string="Planner" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_htplus_demand_plan"
        parent="htplus_aps_menu_planning"
        action="action_htplus_demand_plan"
        sequence="10"/>
</odoo>
