<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_htplus_aps" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.htplus.aps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HTPlus APS" string="HTPlus APS" name="htplus_aps">
                    <block title="Planning Defaults">
                        <setting string="Schedule Objective"
                            help="Default objective used by the APS engine when no planning rule applies.">
                            <field name="htplus_aps_objective"/>
                        </setting>
                        <setting string="Capacity Limit"
                            help="Default maximum work center load as a percentage.">
                            <field name="htplus_aps_capacity_limit_pct"/>
                        </setting>
                        <setting string="Buffers">
                            <div class="row mt-1">
                                <label for="htplus_aps_buffer_before" class="col-3"/>
                                <field name="htplus_aps_buffer_before" class="col-3"/>
                                <label for="htplus_aps_buffer_after" class="col-3"/>
                                <field name="htplus_aps_buffer_after" class="col-3"/>
                            </div>
                        </setting>
                        <setting string="Batch Size">
                            <field name="htplus_aps_batch_size"/>
                        </setting>
                    </block>
                    <block title="Shift Management">
                        <setting string="Default Factory"
                            help="Default factory used when creating shifts.">
                            <field name="htplus_shift_default_factory"/>
                        </setting>
                        <setting string="Shifts per Day"
                            help="Default number of shifts per working day.">
                            <field name="htplus_shift_count_per_day"/>
                        </setting>
                        <setting string="Working Hours">
                            <div class="row mt-1">
                                <label for="htplus_shift_std_hours" class="col-3"/>
                                <field name="htplus_shift_std_hours" class="col-3"/>
                                <label for="htplus_shift_max_ot" class="col-3"/>
                                <field name="htplus_shift_max_ot" class="col-3"/>
                            </div>
                        </setting>
                        <setting string="AI Auto Assignment"
                            help="Allow the system to propose employee assignment automatically.">
                            <field name="htplus_shift_ai_auto_assign"/>
                        </setting>
                        <setting string="Auto Conflict Check"
                            help="Automatically check shift/OT conflicts on assignment.">
                            <field name="htplus_shift_auto_conflict_check"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
