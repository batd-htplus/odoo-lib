<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_schedule_run" model="ir.actions.act_window">
        <field name="name">Schedule Runs</field>
        <field name="res_model">htplus.schedule.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_htplus_workorder_list" model="ir.actions.act_window">
        <field name="name">Scheduled Work Orders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_schedule_run_tree" model="ir.ui.view">
        <field name="name">htplus.schedule.run.tree</field>
        <field name="model">htplus.schedule.run</field>
        <field name="arch" type="xml">
            <list string="Schedule Runs">
                <field name="name"/>
                <field name="version"/>
                <field name="production_plan_id"/>
                <field name="algorithm"/>
                <field name="conflict_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_schedule_run_form" model="ir.ui.view">
        <field name="name">htplus.schedule.run.form</field>
        <field name="model">htplus.schedule.run</field>
        <field name="arch" type="xml">
            <form string="Schedule Run">
                <header>
                    <button name="action_load_workorders_from_plan" string="Load Work Orders from Plan"
                        type="object" invisible="state != 'draft' or not production_plan_id"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_calculate" string="Calculate" type="object"
                        invisible="state != 'draft'" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_run_solver" string="Run Solver" type="object"
                        invisible="state not in ['draft', 'calculated']"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_open_gantt" string="Open Gantt"
                        type="object"
                        invisible="not workorder_ids"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="state != 'calculated'" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_lock" string="Lock" type="object"
                        invisible="state not in ['calculated', 'confirmed']"
                        groups="htplus_factory.group_aps_manager"/>
                    <button name="action_apply" string="Apply to Shop Floor" type="object"
                        invisible="state not in ['confirmed', 'locked'] or apply_state in ['applying', 'applied']"
                        class="btn-primary"
                        groups="htplus_factory.group_aps_manager"/>
                    <button name="action_retry_apply" string="Retry Apply" type="object"
                        invisible="apply_state != 'failed'"
                        groups="htplus_factory.group_aps_manager"/>
                    <button name="action_undo_change" string="Undo Last Change" type="object"
                        groups="htplus_factory.group_aps_planner"/>
                    <field name="state" widget="statusbar"/>
                    <field name="apply_state" widget="statusbar" invisible="apply_state == 'none'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_production_plan" type="object"
                            class="oe_stat_button" icon="fa-industry"
                            invisible="not production_plan_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Production Plan</span>
                            </div>
                        </button>
                        <button name="action_open_gantt" type="object"
                            class="oe_stat_button" icon="fa-tasks">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Gantt</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_plan_id"/>
                            <field name="algorithm"/>
                            <field name="scenario_id"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="conflict_count"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="apply_progress" string="Applied" invisible="not apply_progress"/>
                    <notebook>
                        <page string="Work Orders">
                            <field name="workorder_ids">
                                <list string="Work Orders">
                                    <field name="display_name"/>
                                    <field name="workcenter_id"/>
                                    <field name="line_id"/>
                                    <field name="machine_id"/>
                                    <field name="date_start"/>
                                    <field name="date_finished"/>
                                    <field name="priority"/>
                                    <field name="schedule_conflict"/>
                                    <field name="schedule_state"/>
                                    <field name="locked"/>
                                </list>
                            </field>
                        </page>
                        <page string="Proposals">
                            <field name="line_ids">
                                <list string="Proposals">
                                    <field name="version"/>
                                    <field name="workorder_id"/>
                                    <field name="date_start"/>
                                    <field name="date_finished"/>
                                    <field name="machine_id"/>
                                    <field name="line_id"/>
                                    <field name="applied"/>
                                </list>
                            </field>
                        </page>
                        <page string="Apply Batches">
                            <field name="apply_batch_ids">
                                <list string="Apply Batches">
                                    <field name="version"/>
                                    <field name="sequence"/>
                                    <field name="line_count"/>
                                    <field name="state"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                    <field name="error"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scheduler Explanation">
                            <field name="last_explanation" readonly="1" placeholder="Run the solver to get an explanation of why this schedule looks the way it does."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_htplus_schedule_run_search" model="ir.ui.view">
        <field name="name">htplus.schedule.run.search</field>
        <field name="model">htplus.schedule.run</field>
        <field name="arch" type="xml">
            <search string="Schedule Runs">
                <field name="name"/>
                <field name="production_plan_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="calculated" string="Calculated" domain="[('state','=','calculated')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="locked" string="Locked" domain="[('state','=','locked')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_plan" string="Production Plan" context="{'group_by':'production_plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_htplus_mrp_workorder_tree" model="ir.ui.view">
        <field name="name">htplus.mrp.workorder.tree</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="line_id" optional="hide"/>
                <field name="machine_id" optional="hide"/>
                <field name="date_start" optional="show"/>
                <field name="date_finished" optional="show"/>
                <field name="schedule_state" optional="show"/>
                <field name="locked" optional="hide"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_htplus_schedule_run"
        parent="htplus_aps_menu_scheduling"
        action="action_htplus_schedule_run"
        sequence="10"/>
    <menuitem id="menu_htplus_workorder_list"
        parent="htplus_aps_menu_scheduling"
        action="action_htplus_workorder_list"
        sequence="20"/>
</odoo>
