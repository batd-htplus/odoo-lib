<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_dashboard_open" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_htplus_dashboard_kpi"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <record id="htplus_factory.htplus_aps_menu_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <record id="view_htplus_dashboard_kpi_form" model="ir.ui.view">
        <field name="name">htplus.dashboard.kpi.form</field>
        <field name="model">htplus.dashboard.kpi</field>
        <field name="arch" type="xml">
            <form string="Production Dashboard">
                <header>
                    <button name="action_refresh" string="Refresh" type="object" class="btn-primary"/>
                    <button name="action_open_working_plan" string="Open Working Plan" type="object"/>
                    <button name="action_open_gantt" string="Open Gantt" type="object"/>
                    <button name="action_open_conflicts" string="Open Conflicts" type="object"
                        invisible="conflict_count == 0"/>
                    <button name="action_open_material_shortages" string="Material Shortages"
                        type="object" invisible="material_shortage_count == 0"/>
<button name="action_open_schedule" string="Open Schedule Runs"
                            type="object"/>
                        <button name="action_open_workorders" string="Open Work Orders"
                            type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_plan_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    <div class="alert alert-warning mb-3" role="status"
                        invisible="not alert_summary or alert_summary == 'No alerts'">
                        <strong>Needs attention</strong>
                        <field name="alert_summary" nolabel="1" class="mb-0"/>
                    </div>
                    </group>
                    <div class="row" name="kpi_tiles">
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="plan_count"/></h3><div class="text-muted small">Production Plans</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="demand_qty"/></h3><div class="text-muted small">Demand Qty</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="planned_qty"/></h3><div class="text-muted small">Planned Production</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="workorder_count"/></h3><div class="text-muted small">Work Orders</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="scheduled_wo"/></h3><div class="text-muted small">Scheduled</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="conflict_count == 0"><field name="conflict_count"/></h3><h3 class="text-muted" invisible="conflict_count != 0"><field name="conflict_count"/></h3><div class="text-muted small">Schedule Conflicts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="late_wo == 0"><field name="late_wo"/></h3><h3 class="text-muted" invisible="late_wo != 0"><field name="late_wo"/></h3><div class="text-muted small">Late Work Orders</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="material_shortage_count == 0"><field name="material_shortage_count"/></h3><h3 class="text-muted" invisible="material_shortage_count != 0"><field name="material_shortage_count"/></h3><div class="text-muted small">Material Shortages</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="machine_down == 0"><field name="machine_down"/></h3><h3 class="text-muted" invisible="machine_down != 0"><field name="machine_down"/></h3><div class="text-muted small">Machines Down</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="locked_wo"/></h3><div class="text-muted small">Locked Work Orders</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_dashboard"
        parent="htplus_factory.htplus_aps_menu_root"
        action="action_htplus_dashboard_open"
        sequence="5"
        groups="htplus_factory.group_aps_user"/>
</odoo>
