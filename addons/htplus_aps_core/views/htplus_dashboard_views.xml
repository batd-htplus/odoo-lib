<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">htplus.dashboard.kpi</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <record id="view_htplus_dashboard_kpi_form" model="ir.ui.view">
        <field name="name">htplus.dashboard.kpi.form</field>
        <field name="model">htplus.dashboard.kpi</field>
        <field name="arch" type="xml">
            <form string="Production Dashboard">
                <header>
                    <button name="action_refresh" string="Refresh" type="object" class="btn-primary"/>
                    <button name="action_open_working_plan" string="Open Working Plan" type="object"/>
                    <button name="action_open_gantt" string="Open Gantt" type="object"/>
                    <button name="action_open_conflicts" string="Open Conflicts" type="object"
                        invisible="conflict_count == 0"/>
                    <button name="action_open_material_shortages" string="Material Shortages"
                        type="object" invisible="material_shortage_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_plan_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Alerts">
                            <field name="alert_summary" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <div class="row">
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="plan_count"/></h3>
                                    <div>Production Plans</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="demand_qty"/></h3>
                                    <div>Demand Qty</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="planned_qty"/></h3>
                                    <div>Planned Production</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="workorder_count"/></h3>
                                    <div>Work Orders</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="scheduled_wo"/></h3>
                                    <div>Scheduled</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger"><field name="conflict_count"/></h3>
                                    <div>Schedule Conflicts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-warning"><field name="late_wo"/></h3>
                                    <div>Late Work Orders</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger"><field name="material_shortage_count"/></h3>
                                    <div>Material Shortages</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger"><field name="machine_down"/></h3>
                                    <div>Machines Down</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="locked_wo"/></h3>
                                    <div>Locked Work Orders</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-warning"><field name="assignment_conflict_count"/></h3>
                                    <div>Assignment Conflicts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-warning"><field name="shortage_shifts"/></h3>
                                    <div>Shifts Short Manpower</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group>
                        <button name="action_open_schedule" string="Open Schedule Runs"
                            type="object"/>
                        <button name="action_open_workorders" string="Open Work Orders"
                            type="object"/>
                        <button name="action_open_shifts" string="Open Shifts"
                            type="object"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_dashboard"
        parent="htplus_factory.htplus_aps_menu_root"
        action="action_htplus_dashboard"
        sequence="15"/>
</odoo>
