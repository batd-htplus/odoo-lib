<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_system_health" model="ir.actions.act_window">
        <field name="name">System Health</field>
        <field name="res_model">htplus.system.health</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <record id="view_htplus_system_health_form" model="ir.ui.view">
        <field name="name">htplus.system.health.form</field>
        <field name="model">htplus.system.health</field>
        <field name="arch" type="xml">
            <form string="System Health">
                <header>
                    <button name="action_refresh" string="Refresh" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group name="health_alerts" string="Alerts">
                            <field name="alert_summary" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <group name="health_jobs" string="Scheduled Jobs">
                        <div class="row">
                            <div class="col-6 col-md-4 col-xl-2 mb-2">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-primary"><field name="cron_total"/></h3><div class="text-muted small">Cron Jobs</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2 mb-2">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-primary"><field name="cron_active"/></h3><div class="text-muted small">Active</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2 mb-2">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-danger" invisible="cron_overdue == 0"><field name="cron_overdue"/></h3><h3 class="text-muted" invisible="cron_overdue != 0"><field name="cron_overdue"/></h3><div class="text-muted small">Overdue</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </group>
                    <group name="health_data" string="Data">
                        <div class="row">
                            <div class="col-6 col-md-4 col-xl-2 mb-2">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-primary"><field name="change_count"/></h3><div class="text-muted small">Schedule Change Logs</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2 mb-2">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-danger" invisible="conflict_count == 0"><field name="conflict_count"/></h3><h3 class="text-muted" invisible="conflict_count != 0"><field name="conflict_count"/></h3><div class="text-muted small">Schedule Conflicts</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2 mb-2">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-danger" invisible="machine_down == 0"><field name="machine_down"/></h3><h3 class="text-muted" invisible="machine_down != 0"><field name="machine_down"/></h3><div class="text-muted small">Machines Down</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_system_health"
        parent="htplus_factory.htplus_aps_menu_root"
        action="action_htplus_system_health"
        sequence="16"/>
</odoo>
