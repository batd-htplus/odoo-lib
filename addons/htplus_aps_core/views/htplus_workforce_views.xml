<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_workforce_assignment" model="ir.actions.act_window">
        <field name="name">Workforce Assignments</field>
        <field name="res_model">htplus.workforce.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_workforce_assignment_tree" model="ir.ui.view">
        <field name="name">htplus.workforce.assignment.tree</field>
        <field name="model">htplus.workforce.assignment</field>
        <field name="arch" type="xml">
            <list string="Workforce Assignments">
                <field name="name"/>
                <field name="shift_id"/>
                <field name="workorder_id"/>
                <field name="employee_id"/>
                <field name="qty"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="skill_ok"/>
                <field name="conflict"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_workforce_assignment_form" model="ir.ui.view">
        <field name="name">htplus.workforce.assignment.form</field>
        <field name="model">htplus.workforce.assignment</field>
        <field name="arch" type="xml">
            <form string="Workforce Assignment">
                <header>
                    <button name="action_validate" string="Validate" type="object"
                        invisible="state != 'draft'"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="state != 'draft'" class="btn-primary"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ['draft', 'confirmed']"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="shift_id"/>
                            <field name="workorder_id"/>
                            <field name="employee_id"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Validation">
                        <group>
                            <field name="skill_ok"/>
                            <field name="ot_ok"/>
                        </group>
                        <group>
                            <field name="conflict"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_workforce_assignment"
        parent="htplus_aps_menu_workforce"
        action="action_htplus_workforce_assignment"
        sequence="10"/>
</odoo>
