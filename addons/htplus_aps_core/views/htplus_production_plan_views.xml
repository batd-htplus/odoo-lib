<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_production_plan" model="ir.actions.act_window">
        <field name="name">Production Plans</field>
        <field name="res_model">htplus.production.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_production_plan_tree" model="ir.ui.view">
        <field name="name">htplus.production.plan.tree</field>
        <field name="model">htplus.production.plan</field>
        <field name="arch" type="xml">
            <list string="Production Plans">
                <field name="name"/>
                <field name="demand_plan_id"/>
                <field name="factory_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_production_plan_form" model="ir.ui.view">
        <field name="name">htplus.production.plan.form</field>
        <field name="model">htplus.production.plan</field>
        <field name="arch" type="xml">
            <form string="Production Plan">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="',confirm,' not in htplus_allowed_transitions" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_approve" string="Approve" type="object"
                        invisible="',approve,' not in htplus_allowed_transitions"
                        groups="htplus_factory.group_aps_manager"/>
                    <button name="action_check_materials" string="Check Materials"
                        type="object" invisible="state in ['locked', 'cancelled']"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_create_productions" string="Create Manufacturing Orders"
                        type="object" invisible="state != 'approved'" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_create_schedule" string="Create Schedule Run"
                        type="object"
                        invisible="state not in ['approved', 'locked']"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_open_latest_schedule" string="Open Schedule"
                        type="object"
                        invisible="not schedule_run_count"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_open_gantt" string="Open Gantt"
                        type="object"
                        invisible="workorder_count == 0"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_use_on_dashboard" string="Use on Dashboard"
                        type="object"
                        invisible="state in ['draft', 'cancelled']"/>
                    <button name="action_lock" string="Lock" type="object"
                        invisible="',lock,' not in htplus_allowed_transitions"
                        groups="htplus_factory.group_aps_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="',cancel,' not in htplus_allowed_transitions"
                        groups="htplus_factory.group_aps_planner"/>
                    <field name="state" widget="statusbar"/>
                    <field name="htplus_allowed_transitions" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_demand_plan" type="object"
                            class="oe_stat_button" icon="fa-list"
                            invisible="not demand_plan_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Demand Plan</span>
                            </div>
                        </button>
                        <button name="action_open_productions" type="object"
                            class="oe_stat_button" icon="fa-wrench"
                            invisible="production_count == 0">
                            <field name="production_count" widget="statinfo" string="MOs"/>
                        </button>
                        <button name="action_open_schedule_runs" type="object"
                            class="oe_stat_button" icon="fa-calendar"
                            invisible="schedule_run_count == 0">
                            <field name="schedule_run_count" widget="statinfo" string="Schedules"/>
                        </button>
                        <button name="action_open_gantt" type="object"
                            class="oe_stat_button" icon="fa-tasks"
                            invisible="workorder_count == 0">
                            <field name="workorder_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="demand_plan_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list string="Production Lines" editable="bottom">
                                    <field name="sequence"/>
                                    <field name="product_id"/>
                                    <field name="product_tmpl_id" column_invisible="1"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="date_deadline"/>
                                    <field name="bom_id"/>
                                    <field name="priority"/>
                                    <field name="material_ok"/>
                                    <field name="material_note" optional="show"/>
                                    <field name="capacity_ok" optional="hide"/>
                                    <field name="production_id" optional="show"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manufacturing Orders">
                            <field name="production_ids"/>
                        </page>
                        <page string="Schedule Runs">
                            <field name="schedule_run_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_htplus_production_plan_search" model="ir.ui.view">
        <field name="name">htplus.production.plan.search</field>
        <field name="model">htplus.production.plan</field>
        <field name="arch" type="xml">
            <search string="Production Plans">
                <field name="name"/>
                <field name="demand_plan_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="locked" string="Locked" domain="[('state','=','locked')]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_user" string="Planner" context="{'group_by':'user_id'}"/>
                    <filter name="group_demand" string="Demand Plan" context="{'group_by':'demand_plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_htplus_production_plan"
        parent="htplus_aps_menu_planning"
        action="action_htplus_production_plan"
        sequence="20"/>
</odoo>
