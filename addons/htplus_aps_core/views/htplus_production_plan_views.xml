<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_production_plan" model="ir.actions.act_window">
        <field name="name">Production Plans</field>
        <field name="res_model">htplus.production.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_production_plan_tree" model="ir.ui.view">
        <field name="name">htplus.production.plan.tree</field>
        <field name="model">htplus.production.plan</field>
        <field name="arch" type="xml">
            <list string="Production Plans">
                <field name="name"/>
                <field name="demand_plan_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_production_plan_form" model="ir.ui.view">
        <field name="name">htplus.production.plan.form</field>
        <field name="model">htplus.production.plan</field>
        <field name="arch" type="xml">
            <form string="Production Plan">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="state != 'draft'" class="btn-primary"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <button name="action_approve" string="Approve" type="object"
                        invisible="state != 'confirmed'"
                        groups="htplus_planning_base.group_aps_manager"/>
                    <button name="action_check_materials" string="Check Materials"
                        type="object" invisible="state in ['locked', 'cancelled']"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <button name="action_create_productions" string="Create Manufacturing Orders"
                        type="object" invisible="state != 'approved'" class="btn-primary"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <button name="action_create_schedule" string="Create Schedule Run"
                        type="object"
                        invisible="state not in ['approved', 'locked']"
                        class="btn-primary"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <button name="action_lock" string="Lock" type="object"
                        invisible="state not in ['approved', 'confirmed']"
                        groups="htplus_planning_base.group_aps_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ['draft', 'confirmed', 'approved']"
                        groups="htplus_planning_base.group_aps_planner"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="demand_plan_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list string="Production Lines" editable="bottom">
                                    <field name="sequence"/>
                                    <field name="product_id"/>
                                    <field name="product_tmpl_id" column_invisible="1"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="date_deadline"/>
                                    <field name="bom_id"/>
                                    <field name="priority"/>
                                    <field name="material_ok"/>
                                    <field name="material_note" optional="show"/>
                                    <field name="capacity_ok" optional="hide"/>
                                    <field name="production_id" optional="show"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manufacturing Orders">
                            <field name="production_ids"/>
                        </page>
                        <page string="Schedule Runs">
                            <field name="schedule_run_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_production_plan"
        parent="htplus_aps_menu_planning"
        action="action_htplus_production_plan"
        sequence="20"/>
</odoo>
