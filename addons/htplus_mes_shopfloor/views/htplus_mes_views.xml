<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_workorder_actual" model="ir.actions.act_window">
        <field name="name">Work Order Execution</field>
        <field name="res_model">htplus.workorder.actual</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_downtime" model="ir.actions.act_window">
        <field name="name">Downtime</field>
        <field name="res_model">htplus.downtime</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_downtime_reason" model="ir.actions.act_window">
        <field name="name">Downtime Reasons</field>
        <field name="res_model">htplus.downtime.reason</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_defect" model="ir.actions.act_window">
        <field name="name">Defects</field>
        <field name="res_model">htplus.defect</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_workorder_ng" model="ir.actions.act_window">
        <field name="name">NG Records</field>
        <field name="res_model">htplus.workorder.ng</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_machine_stop" model="ir.actions.act_window">
        <field name="name">Machine Stops</field>
        <field name="res_model">htplus.machine.stop</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_issue" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">htplus.issue</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_shift_completion" model="ir.actions.act_window">
        <field name="name">Shift Completion</field>
        <field name="res_model">htplus.shift.completion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_htplus_workorder_actual_tree" model="ir.ui.view">
        <field name="name">htplus.workorder.actual.tree</field>
        <field name="model">htplus.workorder.actual</field>
        <field name="arch" type="xml">
            <tree string="Work Order Execution">
                <field name="workorder_id"/>
                <field name="date_start"/>
                <field name="date_finished"/>
                <field name="employee_id"/>
                <field name="machine_id"/>
                <field name="qty_good"/>
                <field name="qty_ng"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_workorder_actual_form" model="ir.ui.view">
        <field name="name">htplus.workorder.actual.form</field>
        <field name="model">htplus.workorder.actual</field>
        <field name="arch" type="xml">
            <form string="Work Order Execution">
                <header>
                    <button name="action_pause" string="Pause" type="object" states="running"/>
                    <button name="action_finish" string="Finish" type="object" states="running"
                        class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="workorder_id"/>
                            <field name="employee_id"/>
                            <field name="machine_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_finished"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Production">
                        <group>
                            <field name="qty_done"/>
                            <field name="qty_good"/>
                        </group>
                        <group>
                            <field name="qty_ng"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_downtime_tree" model="ir.ui.view">
        <field name="name">htplus.downtime.tree</field>
        <field name="model">htplus.downtime</field>
        <field name="arch" type="xml">
            <tree string="Downtime">
                <field name="workorder_id"/>
                <field name="machine_id"/>
                <field name="reason_id"/>
                <field name="type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_minutes"/>
                <field name="cost"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_downtime_form" model="ir.ui.view">
        <field name="name">htplus.downtime.form</field>
        <field name="model">htplus.downtime</field>
        <field name="arch" type="xml">
            <form string="Downtime">
                <sheet>
                    <group>
                        <group>
                            <field name="workorder_id"/>
                            <field name="machine_id"/>
                            <field name="reason_id"/>
                        </group>
                        <group>
                            <field name="type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_minutes"/>
                            <field name="cost"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_downtime_reason_tree" model="ir.ui.view">
        <field name="name">htplus.downtime.reason.tree</field>
        <field name="model">htplus.downtime.reason</field>
        <field name="arch" type="xml">
            <tree string="Downtime Reasons">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_workorder_ng_tree" model="ir.ui.view">
        <field name="name">htplus.workorder.ng.tree</field>
        <field name="model">htplus.workorder.ng</field>
        <field name="arch" type="xml">
            <tree string="NG Records">
                <field name="workorder_id"/>
                <field name="defect_id"/>
                <field name="qty"/>
                <field name="date"/>
                <field name="employee_id"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_workorder_ng_form" model="ir.ui.view">
        <field name="name">htplus.workorder.ng.form</field>
        <field name="model">htplus.workorder.ng</field>
        <field name="arch" type="xml">
            <form string="NG Record">
                <sheet>
                    <group>
                        <group>
                            <field name="workorder_id"/>
                            <field name="defect_id"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                    <group string="Analysis">
                        <group>
                            <field name="root_cause"/>
                        </group>
                        <group>
                            <field name="countermeasure"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_machine_stop_tree" model="ir.ui.view">
        <field name="name">htplus.machine.stop.tree</field>
        <field name="model">htplus.machine.stop</field>
        <field name="arch" type="xml">
            <tree string="Machine Stops">
                <field name="machine_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="reason_id"/>
                <field name="type"/>
                <field name="duration_minutes"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_issue_tree" model="ir.ui.view">
        <field name="name">htplus.issue.tree</field>
        <field name="model">htplus.issue</field>
        <field name="arch" type="xml">
            <tree string="Issues">
                <field name="name"/>
                <field name="workorder_id"/>
                <field name="type"/>
                <field name="severity"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_issue_form" model="ir.ui.view">
        <field name="name">htplus.issue.form</field>
        <field name="model">htplus.issue</field>
        <field name="arch" type="xml">
            <form string="Issue">
                <header>
                    <button name="action_open" string="Reopen" type="object" states="resolved,closed"/>
                    <button name="action_in_progress" string="In Progress" type="object" states="open"/>
                    <button name="action_resolve" string="Resolve" type="object" states="open,in_progress"
                        class="btn-primary"/>
                    <button name="action_close" string="Close" type="object" states="resolved"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="workorder_id"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="date"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                    <group string="Analysis">
                        <group>
                            <field name="root_cause"/>
                        </group>
                        <group>
                            <field name="countermeasure"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_shift_completion_tree" model="ir.ui.view">
        <field name="name">htplus.shift.completion.tree</field>
        <field name="model">htplus.shift.completion</field>
        <field name="arch" type="xml">
            <tree string="Shift Completion">
                <field name="workorder_id"/>
                <field name="shift_template_id"/>
                <field name="date"/>
                <field name="qty_target"/>
                <field name="qty_done"/>
                <field name="qty_good"/>
                <field name="qty_ng"/>
                <field name="downtime_minutes"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_shift_completion_form" model="ir.ui.view">
        <field name="name">htplus.shift.completion.form</field>
        <field name="model">htplus.shift.completion</field>
        <field name="arch" type="xml">
            <form string="Shift Completion">
                <sheet>
                    <group>
                        <group>
                            <field name="workorder_id"/>
                            <field name="shift_template_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="qty_target"/>
                            <field name="qty_done"/>
                            <field name="qty_good"/>
                            <field name="qty_ng"/>
                        </group>
                    </group>
                    <group>
                        <field name="downtime_minutes"/>
                        <field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_workorder_actual"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_workorder_actual"
        sequence="10"/>
    <menuitem id="menu_htplus_downtime"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_downtime"
        sequence="20"/>
    <menuitem id="menu_htplus_downtime_reason"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_downtime_reason"
        sequence="30"/>
    <menuitem id="menu_htplus_defect"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_defect"
        sequence="40"/>
    <menuitem id="menu_htplus_workorder_ng"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_workorder_ng"
        sequence="50"/>
    <menuitem id="menu_htplus_machine_stop"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_machine_stop"
        sequence="60"/>
    <menuitem id="menu_htplus_issue"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_issue"
        sequence="70"/>
    <menuitem id="menu_htplus_shift_completion"
        parent="htplus_mes_menu_shopfloor"
        action="action_htplus_shift_completion"
        sequence="80"/>
</odoo>
