        <field name="name">htplus.issue: own factories only</field>
        <field name="model_id" ref="model_htplus_issue"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_issue_all_factories" model="ir.rule">
        <field name="name">htplus.issue: all factories</field>
        <field name="model_id" ref="model_htplus_issue"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_htplus_workorder_ng_factory" model="ir.rule">
