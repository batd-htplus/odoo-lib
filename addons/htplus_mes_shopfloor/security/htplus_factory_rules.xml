        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_machine_stop_all_factories" model="ir.rule">
        <field name="name">htplus.machine.stop: all factories</field>
        <field name="model_id" ref="model_htplus_machine_stop"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

