        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_workorder_ng_all_factories" model="ir.rule">
        <field name="name">htplus.workorder.ng: all factories</field>
        <field name="model_id" ref="model_htplus_workorder_ng"/>
