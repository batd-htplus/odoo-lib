<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="htplus_production_daily_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Daily Production Report</h2>
                        <div class="row">
                            <div class="col-6">
                                <strong>From:</strong> <span t-field="report.date_from"/>
                            </div>
                            <div class="col-6">
                                <strong>To:</strong> <span t-field="report.date_to"/>
                            </div>
                        </div>
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Work Order</th>
                                    <th>Work Center</th>
                                    <th>Machine</th>
                                    <th class="text-right">Qty Good</th>
                                    <th class="text-right">Qty NG</th>
                                    <th class="text-right">Downtime (min)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report._get_lines()" t-as="line">
                                    <tr>
                                        <td t-esc="line['workorder']"/>
                                        <td t-esc="line['workcenter']"/>
                                        <td t-esc="line['machine']"/>
                                        <td class="text-right" t-esc="line['qty_good']"/>
                                        <td class="text-right" t-esc="line['qty_ng']"/>
                                        <td class="text-right" t-esc="line['downtime_minutes']"/>
                                    </tr>
                                </t>
                            </tbody>
                            <t t-set="totals" t-value="report._get_totals()"/>
                            <tfoot>
                                <tr>
                                    <th colspan="3">Total</th>
                                    <th class="text-right" t-esc="totals['qty_good']"/>
                                    <th class="text-right" t-esc="totals['qty_ng']"/>
                                    <th class="text-right" t-esc="totals['downtime_minutes']"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
