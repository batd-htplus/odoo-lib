<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_planning_config" model="ir.actions.act_window">
        <field name="name">Engine Configurations</field>
        <field name="res_model">htplus.planning.config</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('htplus_factory.group_aps_manager'))]"/>
    </record>
    <record id="action_htplus_planning_forecast" model="ir.actions.act_window">
        <field name="name">Demand Forecast</field>
        <field name="res_model">htplus.planning.forecast</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_htplus_planning_chat" model="ir.actions.act_window">
        <field name="name">Planning Assistant</field>
        <field name="res_model">htplus.planning.chat</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_htplus_planning_recommendation" model="ir.actions.act_window">
        <field name="name">Recommendations</field>
        <field name="res_model">htplus.planning.recommendation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_htplus_planning_request_log" model="ir.actions.act_window">
        <field name="name">Request Log</field>
        <field name="res_model">htplus.planning.request.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_planning_config_tree" model="ir.ui.view">
        <field name="name">htplus.planning.config.tree</field>
        <field name="model">htplus.planning.config</field>
        <field name="arch" type="xml">
            <list string="Engine Configurations">
                <field name="name"/>
                <field name="url"/>
                <field name="model"/>
                <field name="timeout_sec"/>
                <field name="circuit_state"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_planning_config_form" model="ir.ui.view">
        <field name="name">htplus.planning.config.form</field>
        <field name="model">htplus.planning.config</field>
        <field name="arch" type="xml">
            <form string="Engine Configuration">
                <header>
                    <button name="action_reset_circuit" string="Reset Circuit Breaker" type="object"
                            invisible="circuit_state == 'closed'"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="api_key" password="True"
                                    placeholder="Leave empty to use HTPLUS_PLANNING_API_KEY env"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="timeout_sec"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Resilience">
                        <group>
                            <field name="retry_max"/>
                            <field name="retry_backoff"/>
                            <field name="log_requests"/>
                        </group>
                        <group>
                            <field name="circuit_failure_threshold"/>
                            <field name="circuit_recovery_timeout"/>
                            <field name="circuit_state"/>
                            <field name="circuit_failures"/>
                            <field name="circuit_open_since"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_planning_forecast_tree" model="ir.ui.view">
        <field name="name">htplus.planning.forecast.tree</field>
        <field name="model">htplus.planning.forecast</field>
        <field name="arch" type="xml">
            <list string="Demand Forecasts">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="horizon_days"/>
                <field name="model"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_planning_forecast_form" model="ir.ui.view">
        <field name="name">htplus.planning.forecast.form</field>
        <field name="model">htplus.planning.forecast</field>
        <field name="arch" type="xml">
            <form string="Demand Forecast">
                <header>
                    <button name="action_run" string="Run Forecast" type="object"
                        invisible="state != 'draft'" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_apply" string="Apply to Demand Plan" type="object"
                        invisible="state != 'computed'" class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="config_id"/>
                            <field name="model"/>
                            <field name="horizon_days"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Products">
                        <field name="product_ids"/>
                    </group>
                    <notebook>
                        <page string="Forecast Lines">
                            <field name="line_ids">
                                <list string="Forecast Lines">
                                    <field name="product_id"/>
                                    <field name="date"/>
                                    <field name="qty"/>
                                    <field name="confidence"/>
                                    <field name="model"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_planning_chat_tree" model="ir.ui.view">
        <field name="name">htplus.planning.chat.tree</field>
        <field name="model">htplus.planning.chat</field>
        <field name="arch" type="xml">
            <list string="Planning Assistant Sessions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_planning_chat_form" model="ir.ui.view">
        <field name="name">htplus.planning.chat.form</field>
        <field name="model">htplus.planning.chat</field>
        <field name="arch" type="xml">
            <form string="Planning Assistant">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group string="Messages">
                        <field name="line_ids">
                            <list string="Messages">
                                <field name="role"/>
                                <field name="content"/>
                                <field name="created_at"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_planning_recommendation_tree" model="ir.ui.view">
        <field name="name">htplus.planning.recommendation.tree</field>
        <field name="model">htplus.planning.recommendation</field>
        <field name="arch" type="xml">
            <list string="Recommendations">
                <field name="name"/>
                <field name="type"/>
                <field name="title"/>
                <field name="source_workorder_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_planning_recommendation_form" model="ir.ui.view">
        <field name="name">htplus.planning.recommendation.form</field>
        <field name="model">htplus.planning.recommendation</field>
        <field name="arch" type="xml">
            <form string="Recommendation">
                <header>
                    <button name="action_apply" string="Apply" type="object" invisible="state != 'new'"
                        class="btn-primary"
                        groups="htplus_factory.group_aps_planner"/>
                    <button name="action_dismiss" string="Dismiss" type="object" invisible="state != 'new'"
                        groups="htplus_factory.group_aps_planner"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="source_workorder_id"/>
                            <field name="source_plan_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="title"/>
                        <field name="summary"/>
                        <field name="explanation"/>
                    </group>
                    <group string="Payload">
                        <field name="payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_htplus_planning_request_log_tree" model="ir.ui.view">
        <field name="name">htplus.planning.request.log.tree</field>
        <field name="model">htplus.planning.request.log</field>
        <field name="arch" type="xml">
            <list string="Request Log">
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status"/>
                <field name="status_code"/>
                <field name="retries"/>
                <field name="response_time_ms"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_planning_request_log_form" model="ir.ui.view">
        <field name="name">htplus.planning.request.log.form</field>
        <field name="model">htplus.planning.request.log</field>
        <field name="arch" type="xml">
            <form string="Request Log Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="config_id"/>
                            <field name="endpoint"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="status_code"/>
                            <field name="retries"/>
                            <field name="response_time_ms"/>
                            <field name="idempotency_key"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Error">
                        <field name="error"/>
                    </group>
                    <group string="Request Payload">
                        <field name="request_payload"/>
                    </group>
                    <group string="Response">
                        <field name="response"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_htplus_system_health_engine" model="ir.ui.view">
        <field name="name">htplus.system.health.engine</field>
        <field name="model">htplus.system.health</field>
        <field name="inherit_id" ref="htplus_aps_core.view_htplus_system_health_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='health_data']" position="after">
                <group string="Planning Engine">
                    <div class="row">
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="engine_state"/></h3><div class="text-muted small">Circuit</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="engine_failures == 0"><field name="engine_failures"/></h3><h3 class="text-muted" invisible="engine_failures != 0"><field name="engine_failures"/></h3><div class="text-muted small">Consecutive Failures</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-warning"><field name="engine_avg_ms"/></h3><div class="text-muted small">Avg Response (ms)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-primary"><field name="engine_req_ok"/></h3><div class="text-muted small">OK (24h)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="engine_req_failed == 0"><field name="engine_req_failed"/></h3><h3 class="text-muted" invisible="engine_req_failed != 0"><field name="engine_req_failed"/></h3><div class="text-muted small">Failed (24h)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h3 class="text-danger" invisible="forecast_stuck == 0"><field name="forecast_stuck"/></h3><h3 class="text-muted" invisible="forecast_stuck != 0"><field name="forecast_stuck"/></h3><div class="text-muted small">Stuck Forecasts</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group>
                        <field name="engine_open_since"/>
                        <field name="engine_req_skipped"/>
                        <field name="engine_last_error"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_htplus_planning_config"
        parent="htplus_planning_menu"
        action="action_htplus_planning_config"
        sequence="10"/>
    <menuitem id="menu_htplus_planning_forecast"
        parent="htplus_planning_menu"
        action="action_htplus_planning_forecast"
        sequence="20"/>
    <menuitem id="menu_htplus_planning_chat"
        parent="htplus_planning_menu"
        action="action_htplus_planning_chat"
        sequence="30"/>
    <menuitem id="menu_htplus_planning_recommendation"
        parent="htplus_planning_menu"
        action="action_htplus_planning_recommendation"
        sequence="40"/>
    <menuitem id="menu_htplus_planning_request_log"
        parent="htplus_planning_menu"
        action="action_htplus_planning_request_log"
        sequence="50"/>
</odoo>
