<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Skill taxonomy and matrix. Requires hr_skills. -->
    <!-- Views come before the actions that reference them so the actions can
         pin their intended views via view_ids and never shadow hr_skills. -->

    <record id="view_htplus_skill_tree" model="ir.ui.view">
        <field name="name">hr.skill.htplus.tree</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <list string="Production Skills">
                <field name="name" />
                <field name="skill_type_id" />
                <field name="color" widget="color_picker" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_htplus_skill_form" model="ir.ui.view">
        <field name="name">hr.skill.htplus.form</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <form string="Skill">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="skill_type_id" domain="[('id', 'in', [                                     %(htplus_workforce_skills.hr_skill_type_production)d,                                     %(htplus_workforce_skills.hr_skill_type_quality)d,                                     %(htplus_workforce_skills.hr_skill_type_maintenance)d,                                     %(htplus_workforce_skills.hr_skill_type_safety)d,                                 ])]" />
                            <field name="color" widget="color_picker" readonly="1" />
                            <field name="sequence" optional="hide" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_htplus_skill_search" model="ir.ui.view">
        <field name="name">hr.skill.htplus.search</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="skill_type_id" />
                <filter name="production" string="Production" domain="[('skill_type_id','=', %(htplus_workforce_skills.hr_skill_type_production)d)]" />
                <filter name="quality" string="Quality" domain="[('skill_type_id','=', %(htplus_workforce_skills.hr_skill_type_quality)d)]" />
                <filter name="maintenance" string="Maintenance" domain="[('skill_type_id','=', %(htplus_workforce_skills.hr_skill_type_maintenance)d)]" />
                <filter name="safety" string="Safety" domain="[('skill_type_id','=', %(htplus_workforce_skills.hr_skill_type_safety)d)]" />
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'skill_type_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_htplus_employee_skill_tree" model="ir.ui.view">
        <field name="name">hr.employee.skill.htplus.tree</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <list string="Employee Skills">
                <field name="employee_id" />
                <field name="skill_type_id" />
                <field name="skill_id" />
                <field name="skill_level_id" />
                <field name="level_progress" widget="progressbar" />
            </list>
        </field>
    </record>

    <record id="view_htplus_employee_skill_form" model="ir.ui.view">
        <field name="name">hr.employee.skill.htplus.form</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <form string="Employee Skill">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="skill_type_id" domain="[('id', 'in', [                                     %(htplus_workforce_skills.hr_skill_type_production)d,                                     %(htplus_workforce_skills.hr_skill_type_quality)d,                                     %(htplus_workforce_skills.hr_skill_type_maintenance)d,                                     %(htplus_workforce_skills.hr_skill_type_safety)d,                                 ])]" />
                            <field name="skill_id" />
                        </group>
                        <group>
                            <field name="skill_level_id" />
                            <field name="level_progress" widget="progressbar" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_htplus_skill_type" model="ir.actions.act_window">
        <field name="name">Skill Types</field>
        <field name="res_model">hr.skill.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('id', 'in', [                 ref('htplus_workforce_skills.hr_skill_type_production'),                 ref('htplus_workforce_skills.hr_skill_type_quality'),                 ref('htplus_workforce_skills.hr_skill_type_maintenance'),                 ref('htplus_workforce_skills.hr_skill_type_safety'),             ])]" />
        <field name="context" eval="{'default_color': 4}" />
    </record>

    <record id="action_htplus_skill" model="ir.actions.act_window">
        <field name="name">Production Skills</field>
        <field name="res_model">hr.skill</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_htplus_skill_tree'), 'sequence': 10}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_htplus_skill_form'), 'sequence': 10})]"/>
        <field name="search_view_id" ref="view_htplus_skill_search" />
        <field name="domain" eval="[('skill_type_id', 'in', [                 ref('htplus_workforce_skills.hr_skill_type_production'),                 ref('htplus_workforce_skills.hr_skill_type_quality'),                 ref('htplus_workforce_skills.hr_skill_type_maintenance'),                 ref('htplus_workforce_skills.hr_skill_type_safety'),             ])]" />
        <field name="context" eval="{'default_skill_type_id': ref('htplus_workforce_skills.hr_skill_type_production')}" />
    </record>

    <record id="action_htplus_employee_skill" model="ir.actions.act_window">
        <field name="name">Employee Skills</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_htplus_employee_skill_tree'), 'sequence': 10}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_htplus_employee_skill_form'), 'sequence': 10})]"/>
        <field name="domain" eval="[('skill_type_id', 'in', [                 ref('htplus_workforce_skills.hr_skill_type_production'),                 ref('htplus_workforce_skills.hr_skill_type_quality'),                 ref('htplus_workforce_skills.hr_skill_type_maintenance'),                 ref('htplus_workforce_skills.hr_skill_type_safety'),             ])]" />
        <field name="context" eval="{'default_skill_type_id': ref('htplus_workforce_skills.hr_skill_type_production')}" />
    </record>

    <menuitem id="menu_htplus_skill_type" parent="htplus_factory.htplus_aps_menu_master_data" action="action_htplus_skill_type" sequence="115" />

    <menuitem id="menu_htplus_skill" parent="htplus_factory.htplus_aps_menu_master_data" action="action_htplus_skill" sequence="120" />

    <menuitem id="menu_htplus_employee_skill" parent="htplus_factory.htplus_aps_menu_master_data" action="action_htplus_employee_skill" sequence="130" />

</odoo>
