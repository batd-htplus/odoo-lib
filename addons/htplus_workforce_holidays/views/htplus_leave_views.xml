<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee time off beside the shift calendar. Requires hr_holidays. -->

    <record id="action_htplus_holiday" model="ir.actions.act_window">
        <field name="name">Employee Time Off</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,calendar,form</field>
    </record>

    <record id="view_htplus_holiday_calendar" model="ir.ui.view">
        <field name="name">hr.leave.htplus.calendar</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <calendar string="Holidays" date_start="date_from" date_stop="date_to" color="holiday_status_id" mode="month">
                <field name="employee_id" />
                <field name="holiday_status_id" />
            </calendar>
        </field>
    </record>

    <menuitem id="menu_htplus_holiday" parent="htplus_workforce.menu_htplus_shift_mgmt" action="action_htplus_holiday" sequence="40" />

</odoo>
