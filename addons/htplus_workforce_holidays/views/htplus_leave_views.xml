<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee time off: core hr.leave -->
    <record id="action_htplus_holiday" model="ir.actions.act_window">
        <field name="name">Employee Time Off</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
    <record id="view_htplus_holiday_calendar" model="ir.ui.view">
        <field name="name">hr.leave.htplus.calendar</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <calendar string="Holidays" date_start="date_from" date_stop="date_to"
                color="holiday_status_id" mode="month">
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
            </calendar>
        </field>
    </record>
    <!-- Factory shutdown: syncs to resource.calendar.leaves (MRP capacity) -->
    <record id="action_htplus_factory_holiday" model="ir.actions.act_window">
        <field name="name">Factory Holidays</field>
        <field name="res_model">htplus.factory.holiday</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
    <record id="view_htplus_factory_holiday_tree" model="ir.ui.view">
        <field name="name">htplus.factory.holiday.list</field>
        <field name="model">htplus.factory.holiday</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="resource_leave_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_factory_holiday_calendar" model="ir.ui.view">
        <field name="name">htplus.factory.holiday.calendar</field>
        <field name="model">htplus.factory.holiday</field>
        <field name="arch" type="xml">
            <calendar string="Factory Holidays" date_start="date_from" date_stop="date_to"
                color="factory_id" mode="month">
                <field name="factory_id"/>
            </calendar>
        </field>
    </record>
    <record id="view_htplus_factory_holiday_form" model="ir.ui.view">
        <field name="name">htplus.factory.holiday.form</field>
        <field name="model">htplus.factory.holiday</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="factory_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="resource_leave_id" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================== Menus ====================== -->
    <menuitem id="menu_htplus_skill_type"
        parent="htplus_factory.htplus_aps_menu_master_data"
        action="action_htplus_skill_type"
        sequence="115"/>
    <menuitem id="menu_htplus_skill"
        parent="htplus_factory.htplus_aps_menu_master_data"
        action="action_htplus_skill"
        sequence="120"/>
    <menuitem id="menu_htplus_employee_skill"
        parent="htplus_factory.htplus_aps_menu_master_data"
        action="action_htplus_employee_skill"
        sequence="130"/>
    <menuitem id="menu_htplus_holiday"
        parent="htplus_workforce.menu_htplus_shift_mgmt"
        action="action_htplus_holiday"
        sequence="40"/>
    <menuitem id="menu_htplus_factory_holiday"
        parent="htplus_workforce.menu_htplus_shift_mgmt"
        action="action_htplus_factory_holiday"
        sequence="45"/>
    <!--
        A "menu_htplus_employee_planning" entry pointing at
        hr_shift.shift_planning_action used to live here. hr_shift is an
        Odoo Enterprise module and is not present in this stack (see
        docs/04_mrp_integration_decision.md); referencing its action would
        fail ir.model.data resolution at data-load time, before the module
        even reaches install. Screens 09-12 (shift calendar, assignment) are
        HTPlus-owned - see menu_htplus_shift_calendar and menu_htplus_shift_list
        in htplus_shift_views.xml instead.
    -->
</odoo>
