<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Factory scoping for time off. Keys off the employee's home factory
        (hr.employee.htplus_factory_id) so reads stay on one indexed column.

          * the per-user rule lets an operator see their own leaves plus the
            leaves of employees belonging to the factories on their profile;
          * the All Factories rule is the explicit escape hatch, matching the
            pattern used by every other htplus factory rule.
    -->
    <record id="rule_hr_leave_factory" model="ir.rule">
        <field name="name">hr.leave: own leaves and own factories only</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">['|', ('employee_id', '=', user.employee_id.id), ('employee_id.htplus_factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_hr_leave_all_factories" model="ir.rule">
        <field name="name">hr.leave: all factories</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
