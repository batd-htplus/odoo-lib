<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_ai_config" model="ir.actions.act_window">
        <field name="name">AI Configurations</field>
        <field name="res_model">htplus.ai.config</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('htplus_planning_base.group_aps_manager'))]"/>
    </record>
    <record id="action_htplus_ai_forecast" model="ir.actions.act_window">
        <field name="name">Demand Forecast</field>
        <field name="res_model">htplus.ai.forecast</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_ai_chat" model="ir.actions.act_window">
        <field name="name">AI Chat</field>
        <field name="res_model">htplus.ai.chat</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_htplus_ai_recommendation" model="ir.actions.act_window">
        <field name="name">Recommendations</field>
        <field name="res_model">htplus.ai.recommendation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_htplus_ai_config_tree" model="ir.ui.view">
        <field name="name">htplus.ai.config.tree</field>
        <field name="model">htplus.ai.config</field>
        <field name="arch" type="xml">
            <tree string="AI Configurations">
                <field name="name"/>
                <field name="url"/>
                <field name="model"/>
                <field name="timeout_sec"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_ai_config_form" model="ir.ui.view">
        <field name="name">htplus.ai.config.form</field>
        <field name="model">htplus.ai.config</field>
        <field name="arch" type="xml">
            <form string="AI Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="api_key"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="timeout_sec"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_ai_forecast_tree" model="ir.ui.view">
        <field name="name">htplus.ai.forecast.tree</field>
        <field name="model">htplus.ai.forecast</field>
        <field name="arch" type="xml">
            <tree string="Demand Forecasts">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="horizon_days"/>
                <field name="model"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_ai_forecast_form" model="ir.ui.view">
        <field name="name">htplus.ai.forecast.form</field>
        <field name="model">htplus.ai.forecast</field>
        <field name="arch" type="xml">
            <form string="Demand Forecast">
                <header>
                    <button name="action_run" string="Run Forecast" type="object"
                        states="draft" class="btn-primary"/>
                    <button name="action_apply" string="Apply to Demand Plan" type="object"
                        states="computed"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="config_id"/>
                            <field name="model"/>
                            <field name="horizon_days"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Products">
                        <field name="product_ids"/>
                    </group>
                    <notebook>
                        <page string="Forecast Lines">
                            <field name="line_ids">
                                <tree string="Forecast Lines">
                                    <field name="product_id"/>
                                    <field name="date"/>
                                    <field name="qty"/>
                                    <field name="confidence"/>
                                    <field name="model"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_ai_chat_tree" model="ir.ui.view">
        <field name="name">htplus.ai.chat.tree</field>
        <field name="model">htplus.ai.chat</field>
        <field name="arch" type="xml">
            <tree string="AI Chats">
                <field name="name"/>
                <field name="user_id"/>
                <field name="config_id"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_ai_chat_form" model="ir.ui.view">
        <field name="name">htplus.ai.chat.form</field>
        <field name="model">htplus.ai.chat</field>
        <field name="arch" type="xml">
            <form string="AI Chat">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group string="Messages">
                        <field name="line_ids">
                            <tree string="Messages">
                                <field name="role"/>
                                <field name="content"/>
                                <field name="created_at"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_ai_recommendation_tree" model="ir.ui.view">
        <field name="name">htplus.ai.recommendation.tree</field>
        <field name="model">htplus.ai.recommendation</field>
        <field name="arch" type="xml">
            <tree string="AI Recommendations">
                <field name="name"/>
                <field name="type"/>
                <field name="title"/>
                <field name="source_workorder_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_htplus_ai_recommendation_form" model="ir.ui.view">
        <field name="name">htplus.ai.recommendation.form</field>
        <field name="model">htplus.ai.recommendation</field>
        <field name="arch" type="xml">
            <form string="AI Recommendation">
                <header>
                    <button name="action_apply" string="Apply" type="object" states="new"
                        class="btn-primary"/>
                    <button name="action_dismiss" string="Dismiss" type="object" states="new"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="source_workorder_id"/>
                            <field name="source_plan_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="title"/>
                        <field name="summary"/>
                        <field name="explanation"/>
                    </group>
                    <group string="Payload">
                        <field name="payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_ai_config"
        parent="htplus_ai_menu"
        action="action_htplus_ai_config"
        sequence="10"/>
    <menuitem id="menu_htplus_ai_forecast"
        parent="htplus_ai_menu"
        action="action_htplus_ai_forecast"
        sequence="20"/>
    <menuitem id="menu_htplus_ai_chat"
        parent="htplus_ai_menu"
        action="action_htplus_ai_chat"
        sequence="30"/>
    <menuitem id="menu_htplus_ai_recommendation"
        parent="htplus_ai_menu"
        action="action_htplus_ai_recommendation"
        sequence="40"/>
</odoo>
