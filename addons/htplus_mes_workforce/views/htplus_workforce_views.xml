<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_htplus_workforce_assignment_form_mes" model="ir.ui.view">
        <field name="name">htplus.workforce.assignment.form.mes</field>
        <field name="model">htplus.workforce.assignment</field>
        <field name="inherit_id" ref="htplus_workforce.view_htplus_workforce_assignment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_actual" string="Open Shop Floor Actual"
                    type="object" invisible="not actual_id" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='conflict']" position="after">
                <field name="actual_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
