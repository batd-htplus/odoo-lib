<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_htplus_factory" model="ir.actions.act_window">
        <field name="name">Factory</field>
        <field name="res_model">htplus.factory</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_htplus_plant" model="ir.actions.act_window">
        <field name="name">Plant</field>
        <field name="res_model">htplus.plant</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_htplus_line" model="ir.actions.act_window">
        <field name="name">Line</field>
        <field name="res_model">htplus.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_htplus_factory_tree" model="ir.ui.view">
        <field name="name">htplus.factory.tree</field>
        <field name="model">htplus.factory</field>
        <field name="arch" type="xml">
            <list string="Factory">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_factory_form" model="ir.ui.view">
        <field name="name">htplus.factory.form</field>
        <field name="model">htplus.factory</field>
        <field name="arch" type="xml">
            <form string="Factory">
                <header>
                    <button name="action_apply_calendar_to_workcenters" type="object"
                        string="Apply Working Hours to Work Centers" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="resource_calendar_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plants">
                            <field name="plant_ids"/>
                        </page>
                        <page string="Factory Holidays">
                            <field name="holiday_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="resource_leave_id" optional="hide"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_plant_tree" model="ir.ui.view">
        <field name="name">htplus.plant.tree</field>
        <field name="model">htplus.plant</field>
        <field name="arch" type="xml">
            <list string="Plant">
                <field name="code"/>
                <field name="name"/>
                <field name="factory_id"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_plant_form" model="ir.ui.view">
        <field name="name">htplus.plant.form</field>
        <field name="model">htplus.plant</field>
        <field name="arch" type="xml">
            <form string="Plant">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="factory_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_htplus_line_tree" model="ir.ui.view">
        <field name="name">htplus.line.tree</field>
        <field name="model">htplus.line</field>
        <field name="arch" type="xml">
            <list string="Line">
                <field name="code"/>
                <field name="name"/>
                <field name="plant_id"/>
            </list>
        </field>
    </record>
    <record id="view_htplus_line_form" model="ir.ui.view">
        <field name="name">htplus.line.form</field>
        <field name="model">htplus.line</field>
        <field name="arch" type="xml">
            <form string="Line">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="plant_id"/>
                            <field name="factory_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Centers">
                            <field name="workcenter_ids"/>
                        </page>
                        <page string="Machines">
                            <field name="machine_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_workcenter_form_htplus" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.htplus</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="factory_id"/>
                <field name="plant_id"/>
                <field name="line_id"/>
            </xpath>
            <!-- Working hours / capacity: Odoo resource_calendar_id + default_capacity. -->
        </field>
    </record>

    <menuitem id="menu_htplus_factory"
        parent="htplus_aps_menu_master_data"
        action="action_htplus_factory"
        sequence="10"/>
    <menuitem id="menu_htplus_plant"
        parent="htplus_aps_menu_master_data"
        action="action_htplus_plant"
        sequence="20"/>
    <menuitem id="menu_htplus_line"
        parent="htplus_aps_menu_master_data"
        action="action_htplus_line"
        sequence="30"/>
</odoo>
