<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Factory scoping. Two rules per model, OR-ed by Odoo because they target
        different groups:

          * the per-user rule keeps a user inside the factories listed on their
            profile - an empty list therefore means NO access, never unrestricted;
          * the All Factories rule is the explicit, deliberate escape hatch.

        Matching on the stored, indexed factory_id rather than walking
        workcenter -> line -> plant -> factory keeps every read to one indexed
        condition instead of three subqueries.
    -->
    <record id="rule_htplus_shift_template_factory" model="ir.rule">
        <field name="name">htplus.shift.template: own factories only</field>
        <field name="model_id" ref="model_htplus_shift_template"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_shift_template_all_factories" model="ir.rule">
        <field name="name">htplus.shift.template: all factories</field>
        <field name="model_id" ref="model_htplus_shift_template"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_htplus_production_shift_factory" model="ir.rule">
        <field name="name">htplus.production.shift: own factories only</field>
        <field name="model_id" ref="model_htplus_production_shift"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_production_shift_all_factories" model="ir.rule">
        <field name="name">htplus.production.shift: all factories</field>
        <field name="model_id" ref="model_htplus_production_shift"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_htplus_shift_actual_factory" model="ir.rule">
        <field name="name">htplus.shift.actual: own factories only</field>
        <field name="model_id" ref="model_htplus_shift_actual"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_shift_actual_all_factories" model="ir.rule">
        <field name="name">htplus.shift.actual: all factories</field>
        <field name="model_id" ref="model_htplus_shift_actual"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_htplus_shift_member_factory" model="ir.rule">
        <field name="name">htplus.shift.member: own factories only</field>
        <field name="model_id" ref="model_htplus_shift_member"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_aps_user')), (4, ref('htplus_factory.group_mes_operator'))]"/>
        <field name="domain_force">[('factory_id', 'in', user.htplus_factory_ids.ids)]</field>
    </record>

    <record id="rule_htplus_shift_member_all_factories" model="ir.rule">
        <field name="name">htplus.shift.member: all factories</field>
        <field name="model_id" ref="model_htplus_shift_member"/>
        <field name="groups" eval="[(4, ref('htplus_factory.group_htplus_all_factories'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
