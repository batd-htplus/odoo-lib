<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_htplus_shift" model="ir.actions.report">
        <field name="name">Shift Report</field>
        <field name="model">htplus.shift.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">htplus_aps_core.htplus_shift_report_template</field>
        <field name="report_file">htplus_aps_core.htplus_shift_report_template</field>
    </record>

    <record id="action_htplus_shift_report" model="ir.actions.act_window">
        <field name="name">Shift Report</field>
        <field name="res_model">htplus.shift.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_htplus_shift_report_form" model="ir.ui.view">
        <field name="name">htplus.shift.report.form</field>
        <field name="model">htplus.shift.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Shift Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="factory_id"/>
                    <field name="line_id"/>
                    <field name="include_completion"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object"
                        class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_htplus_shift_report"
        parent="htplus_workforce.menu_htplus_shift_mgmt"
        action="action_htplus_shift_report"
        sequence="35"/>

</odoo>
