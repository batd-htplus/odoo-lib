# DEVELOPMENT environment

# --- Image / build -----------------------------------------------------------
ODOO_VERSION=18.0
IMAGE_PREFIX=htplus
PLANNING_SERVICE_VERSION=0.1.0

# --- Database ----------------------------------------------------------------
POSTGRES_USER=odoo
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_dev_only

# --- Odoo --------------------------------------------------------------------
# Master password for the (dev-only) database manager.
ODOO_ADMIN_PASSWD=CHANGE_ME_dev_only
ODOO_LOG_LEVEL=debug
# all = no demo data. Use `false` if you want Odoo's demo records for testing.
ODOO_WITHOUT_DEMO=all

# --- nginx -------------------------------------------------------------------
ODOO_DOMAIN=localhost

# --- planning engine --------------------------------------------------------------
HTPLUS_PLANNING_API_KEY=CHANGE_ME_dev_only
PLANNING_SERVICE_WORKERS=1
