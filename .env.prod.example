# PRODUCTION environment
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Used as:
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d

# --- Image / build -----------------------------------------------------------
ODOO_VERSION=18.0
IMAGE_PREFIX=htplus
PLANNING_SERVICE_VERSION=0.1.0

# --- Database ----------------------------------------------------------------
POSTGRES_USER=odoo

# PostgreSQL tuning. Everything below is sized for a 16 GB RAM / 4 vCPU host.
# Recompute for yours:
#   shared_buffers       ~ 25% of RAM, and MUST fit inside PG_MEMORY
#   effective_cache_size ~ 50-75% of RAM. Planner hint only - allocates nothing,
#                          so it may exceed PG_MEMORY
#   work_mem             per sort/hash node, per connection. Worst case is
#                          max_connections * work_mem * a few nodes - keep small
#   max_connections      >= (ODOO_WORKERS + ODOO_CRON_THREADS) * ODOO_DB_MAXCONN
#                          plus headroom for psql, backups and monitoring
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=8GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_CPUS=2.0
PG_MEMORY=4G

# --- Odoo --------------------------------------------------------------------
# EXACT name of the single production database. The config template turns this
# into an anchored dbfilter (^name$); with list_db=False that is what makes the
# instance strictly single-tenant.
ODOO_DB_NAME=htplus_prod

# The textbook formula is workers = 2 * physical_cores + 1 (= 9 on 4 vCPU).
# Trimmed to 7 here so that Odoo + PostgreSQL + the planning engine still fit in
# 16 GB. Raise it once you have added RAM, not before.
# Never set 0 in production: that disables multiprocessing AND the dedicated
# websocket/bus worker.
ODOO_WORKERS=7
ODOO_CRON_THREADS=2

# Connections each process may open.
# (ODOO_WORKERS + ODOO_CRON_THREADS) * ODOO_DB_MAXCONN must stay under
# PG_MAX_CONNECTIONS.  (7 + 2) * 8 = 72 < 100.
ODOO_DB_MAXCONN=8

# Per-worker memory CEILINGS, not reservations - they exist to kill a leaking
# worker, so do NOT provision workers * hard.
#   soft: finish the current request, then recycle the worker (graceful)
#   hard: kill immediately
# A healthy Odoo worker sits at roughly 300-700 MB. Size the container limit at
# about (workers + cron) * 800 MB plus ~1 GB headroom:
#   (7 + 2) * 800 MB = 7.2 GB  ->  ODOO_MEMORY=8G
ODOO_LIMIT_MEMORY_SOFT=1610612736
ODOO_LIMIT_MEMORY_HARD=2147483648

# Per-request budgets, in seconds.
#   CPU  <  REAL  <  nginx proxy_read_timeout (960s in nginx/prod.conf.template)
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=900
ODOO_LIMIT_TIME_REAL_CRON=1800

# warn keeps the log readable; switch to info while debugging an incident.
ODOO_LOG_LEVEL=warn

ODOO_CPUS=3.0
ODOO_MEMORY=8G

# --- nginx -------------------------------------------------------------------
# Real domain. Must match the certificate in ./certs.
ODOO_DOMAIN=erp.example.com
NGINX_CPUS=0.5
NGINX_MEMORY=256M

# --- planning engine --------------------------------------------------------------
PLANNING_SERVICE_WORKERS=2
PLANNING_CPUS=1.0
PLANNING_MEMORY=1G
