# =============================================================================
# nginx - DEVELOPMENT site config
# =============================================================================
# Rendered by the official nginx image from /etc/nginx/templates/*.template.
# Only variables starting with ODOO_ are substituted (NGINX_ENVSUBST_FILTER),
# so nginx's own $host / $remote_addr / $scheme survive untouched.
#
# No TLS here on purpose: dev traffic is localhost only.
# =============================================================================

# Required for websocket upgrade. Defined here (http-level context: conf.d is
# included inside `http`) so no change to the stock nginx.conf is needed.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server_tokens off;

upstream odoo_http {
    server odoo:8069;
    keepalive 32;
}

# Bus / websocket worker (gevent_port). Odoo 18 endpoint is /websocket.
upstream odoo_bus {
    server odoo:8072;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name ${ODOO_DOMAIN};

    # Dev uploads can be large (demo data, backups)
    client_max_body_size 1G;
    client_body_buffer_size 128k;

    # Generous: you will be sitting on a breakpoint
    proxy_read_timeout 3600s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 3600s;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    access_log /var/log/nginx/odoo.access.log;
    error_log  /var/log/nginx/odoo.error.log;

    # --- Websocket (bus) -----------------------------------------------------
    location /websocket {
        proxy_pass http://odoo_bus;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # --- Long-lived bus polling fallback -------------------------------------
    location /longpolling {
        proxy_pass http://odoo_bus;
    }

    # --- Everything else -----------------------------------------------------
    location / {
        proxy_pass http://odoo_http;
        proxy_redirect off;
        # No proxy_buffering tricks in dev: we want to see errors immediately.
    }

    # NOTE: no `location /web/static` caching block in dev, and Odoo runs with
    # dev_mode=assets, so JS/CSS changes are picked up on reload.

    gzip on;
    gzip_min_length 1100;
    gzip_types text/css text/plain text/xml application/xml application/json
               application/javascript image/svg+xml;
}
