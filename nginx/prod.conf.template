# =============================================================================
# nginx - PRODUCTION site config
# =============================================================================
# Rendered by the official nginx image from /etc/nginx/templates/*.template.
# NGINX_ENVSUBST_FILTER=^ODOO_ ensures only ${ODOO_*} placeholders are replaced
# and nginx runtime variables ($host, $remote_addr, ...) are left alone.
#
# Requires, mounted into the nginx container:
#   /etc/nginx/certs/fullchain.pem
#   /etc/nginx/certs/privkey.pem
#   /var/lib/odoo/filestore   (read-only, for X-Accel-Redirect / x_sendfile)
# =============================================================================

# Required for websocket upgrade. Defined here (http-level context: conf.d is
# included inside `http`) so no change to the stock nginx.conf is needed.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Do not leak the nginx version in error pages / Server header.
server_tokens off;

upstream odoo_http {
    server odoo:8069;
    keepalive 64;
}

upstream odoo_bus {
    server odoo:8072;
    keepalive 64;
}

# --- Brute-force protection --------------------------------------------------
# 10m zone ~ 160k unique IPs. Login: 1 req/s with burst 5.
limit_req_zone $binary_remote_addr zone=odoo_login:10m rate=1r/s;
# Generic API/RPC ceiling; tune to your integration traffic.
limit_req_zone $binary_remote_addr zone=odoo_rpc:10m   rate=20r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=odoo_conn:10m;

# --- HTTP -> HTTPS -----------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${ODOO_DOMAIN};

    # ACME http-01 challenge must stay on plain HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Reject unknown Host headers --------------------------------------------
# Without this, requests to the raw IP reach Odoo and can poison generated URLs.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    return 444;
}

# --- Main site ---------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ODOO_DOMAIN};

    # --- TLS -----------------------------------------------------------------
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling (needs a chain file; harmless if the CA does not support it)
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=30s;
    resolver_timeout 5s;

    # --- Security headers ----------------------------------------------------
    # HSTS: only enable after you are certain HTTPS works on every subdomain.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
    # Hide the nginx version banner (also see server_tokens off in nginx.conf)
    proxy_hide_header X-Powered-By;

    # --- Body / buffers ------------------------------------------------------
    client_max_body_size 200M;      # raise only if you import huge files
    client_body_buffer_size 128k;
    client_body_timeout 60s;
    client_header_timeout 20s;

    # --- Timeouts ------------------------------------------------------------
    # MUST be strictly greater than Odoo's limit_time_real (900s in
    # .env.prod.example), otherwise nginx returns 504 while the worker is still
    # doing useful work. Keep a ~60s margin.
    proxy_connect_timeout 60s;
    proxy_send_timeout    960s;
    proxy_read_timeout    960s;
    send_timeout          960s;
    keepalive_timeout     65s;

    limit_conn odoo_conn 40;

    # --- Proxy headers -------------------------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    access_log /var/log/nginx/odoo.access.log;
    error_log  /var/log/nginx/odoo.error.log warn;

    # --- Block the database manager entirely ---------------------------------
    # Belt and braces: list_db=False already disables it inside Odoo.
    location ~ ^/web/database/(manager|selector|create|drop|duplicate|restore|backup|change_password) {
        return 404;
    }

    # --- Defense in depth: block /saas/* ---------------------------------
    # wk_backup_restore, a vendor module that used to ship in this stack,
    # exposed /saas/database/backup with auth="none" - an unauthenticated
    # full-database-dump endpoint. The module has been removed (see README),
    # so this route no longer exists in Odoo, but the 404 stays in case a
    # future module happens to reuse the same path.
    location /saas/ {
        return 404;
    }

    # --- Login: rate limited -------------------------------------------------
    location = /web/login {
        limit_req zone=odoo_login burst=5 nodelay;
        proxy_pass http://odoo_http;
    }
    location = /web/session/authenticate {
        limit_req zone=odoo_login burst=5 nodelay;
        proxy_pass http://odoo_http;
    }

    # --- Websocket (bus) -----------------------------------------------------
    location /websocket {
        proxy_pass http://odoo_bus;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # A bus connection legitimately idles for minutes.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- Static assets: cached hard (Odoo fingerprints the URLs) --------------
    location ~* /web/assets/ {
        proxy_pass http://odoo_http;
        proxy_cache_valid 200 302 60m;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location ~* /web/image/ {
        proxy_pass http://odoo_http;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    location ~* ^/[^/]+/static/ {
        proxy_pass http://odoo_http;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # --- x_sendfile target ---------------------------------------------------
    # Odoo (x_sendfile = True) answers attachment downloads with
    # `X-Accel-Redirect: /web/filestore/<db>/<hash>`; nginx then streams the file
    # itself and the Odoo worker is freed immediately.
    location /web/filestore {
        internal;
        alias /var/lib/odoo/filestore;
    }

    # --- JSON-RPC / API ------------------------------------------------------
    location /jsonrpc {
        limit_req zone=odoo_rpc burst=40 nodelay;
        proxy_pass http://odoo_http;
    }

    # --- Everything else -----------------------------------------------------
    location / {
        proxy_pass http://odoo_http;
        proxy_redirect off;
        proxy_buffering on;
        proxy_buffers 16 64k;
        proxy_buffer_size 128k;
    }

    # --- Compression ---------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1100;
    gzip_types text/css text/plain text/xml application/xml application/json
               application/javascript application/x-javascript image/svg+xml
               text/javascript;
}
